# Scribe environment — copy to DATA_DIR/.env (e.g. ~/Desktop/Scribe/.env)
# and fill in your own values. Never commit the filled-in file.
#
# writer.sh and core/reconcile.sh source DATA_DIR/.env at startup.

# --- Supabase (only needed when storage.supabase.enabled = true) -------------
# Database password for the connection string configured in config.json at
# .storage.supabase.db_connection (e.g. "sslmode=require host=db.<your-ref>.supabase.co
# port=5432 dbname=postgres user=postgres").
SCRIBE_DB_PASSWORD=

# Alternative: standard libpq variable. SCRIBE_DB_PASSWORD wins if both are set.
# PGPASSWORD=

# How long (seconds) a Supabase connection attempt may block the writer before
# the entry is queued to sync-queue.jsonl instead. Default: 10.
# PGCONNECT_TIMEOUT=10

# --- Optional overrides -------------------------------------------------------
# Point every Scribe tool at a different data directory (overrides pointer.json).
# SCRIBE_DATA_PATH=~/Desktop/Scribe
